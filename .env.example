# PratiDhwani backend configuration.
# Copy this file to .env and adjust as needed. Every value here has a
# built-in default (see backend/core/config.py) — an empty/missing .env
# reproduces the original hardcoded behavior exactly.

# --- Environment -----------------------------------------------------------
# development | production | test
ENVIRONMENT=development

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Model / checkpoint --------------------------------------------------------
CHECKPOINT_PATH=ml/checkpoints/best_model.pt

# Load the model at startup (true) or lazily on first request (false).
# Leave unset to auto-pick based on ENVIRONMENT (production=true, dev=false).
# WARM_START=true

# --- Uploads / security ----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.wav,.flac
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_ENABLED=true

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Docs ------------------------------------------------------------------------
# Disable in production to avoid publicly exposing the OpenAPI schema.
ENABLE_DOCS=true
